# PesaGuard infrastructure environment configuration (merge into root .env)
# No credentials are supplied here. Keep existing database identities for existing volumes.
POSTGRES_USER=pesaguard
POSTGRES_DB=pesaguard
STAGING_POSTGRES_DB=pesaguard_staging
REDIS_URL_DOCKER=redis://redis:6379/0
PESAGUARD_BIND_HOST_DOCKER=0.0.0.0
KAFKA_BOOTSTRAP_SERVERS_DOCKER=redpanda:9092
KAFKA_BOOTSTRAP_SERVERS_FULL=kafka:29092
KAFKA_ADVERTISED_LISTENERS_FULL=PLAINTEXT://kafka:29092
STAGING_KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092
API_SERVER_NAME=
CLOUDFLARE_TUNNEL_TOKEN=
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
PESAGUARD_BACKUP_DIR=/var/backups/pesaguard
PESAGUARD_BACKUP_RETENTION_DAYS=30
PESAGUARD_BACKUP_STATUS_FILE=/var/backups/pesaguard/last_status.json
