{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pesaguard.example/schemas/airtel-money-1.0.json",
  "title": "PesaGuard Airtel Money transaction",
  "type": "object",
  "required": ["transaction_id", "amount", "account_id"],
  "properties": {
    "transaction_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "provider_transaction_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "amount": {"type": ["string", "number"], "pattern": "^[+]?[0-9]+(\\.[0-9]+)?$"},
    "account_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "timestamp": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["RECEIVED", "PENDING", "COMPLETED", "FAILED", "REVERSED"]},
    "transaction_type": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}